# config.env - settings for the SWA k3s lab (prod/dev). Copy to config.env and edit the "EDIT" section.
#   cp config.env.example config.env
# config.env is git-ignored (tenant names, users); every script sources it after cd to this directory.

# ===== EDIT: tenant ==========================================================================
SWA_API_BASE="https://<subdomain>.secretsmgr.cyberark.cloud"   # Secrets Manager SaaS tenant
IDENTITY_URL="https://<tenant-id>.id.cyberark.cloud"           # Identity tenant (01-get-token.sh)
SM_USER=""                                                     # Identity admin user; empty = prompt

# ===== EDIT: lab naming and secrets ==========================================================
BASE_DOMAIN="<domain>"             # trust domains: <env>.swa.<BASE_DOMAIN>
SA_USER="swa-demo-sa"              # service account (Linux user) running the workload in the container
SAFE_POLICY="data/vault/<safe>"    # policy branch holding the secrets the workloads may read
PROD_SECRETS="<account>/username <account>/password"           # relative to SAFE_POLICY
DEV_SECRETS="<account>/username <account>/password"

# ===== EDIT: SWA release bundle (swa-release-v<ver>.tgz extracted here) =====================
SWA_BUNDLE_DIR="$PWD/release"
SWA_VERSION="1.1.4"

# ===== Optional ===============================================================================
LAB_ID="mylab"                          # extra name tag so several lab hosts can share one tenant, e.g. "lab2"
                                   #   -> trust domain prod.lab2.swa.<domain>, authn-jwt/swa-prod-lab2; empty = no tag
HOST_GW=""                         # host address seen from containers; empty = auto (macOS: host.docker.internal, else docker bridge / podman gateway)
PROD_API_PORT=""; DEV_API_PORT=""  # host ports of the server APIs (k3s NodePorts published by the k3s container); empty = 18443 / 18543
API_BIND=""                        # host address those ports listen on; empty = all interfaces
                                   #   Docker Desktop: 127.0.0.1 is enough (agents reach it via host.docker.internal)
                                   #   Linux: keep empty (agents use the bridge gateway, not loopback)

# ===== k3s (runs the SWA Servers, one namespace per environment) ==============================
K3S_IMAGE="docker.io/rancher/k3s:v1.35.9-k3s1"   # SWA Server supports Kubernetes 1.33-1.35
K3S_NAME="swa-k3s"                 # k3s container + docker volume (cluster data, incl. the service-account signing key)
K3S_API_PORT=16443                 # kube-apiserver published on 127.0.0.1:<port> for kubectl/helm on this host
KUBECONFIG="$PWD/state/k3s.kubeconfig"; export KUBECONFIG   # written by 05-k3s-up.sh
SWA_SERVER_CHART="$SWA_BUNDLE_DIR/helm/swa-server-0.1.0.tgz"

# ===== Derived - normally no need to change ==================================================
ENVS="prod dev"
SA_UID=1001
ADMIN_TOKEN_FILE="$PWD/.token"                                                          # written by 01-get-token.sh
SWA_ARCH=$(case "$(uname -m)" in (arm64|aarch64) echo arm64;; (*) echo amd64;; esac)    # container arch (Apple silicon -> arm64)
SWA_IMG_ARCH=${SWA_ARCH/arm64/arm64v8}                                                  # bundle image tag suffix: amd64 | arm64v8
SWA_AGENT_BIN="$SWA_BUNDLE_DIR/binaries/swa-agent_${SWA_VERSION}_linux_${SWA_ARCH}/swa-agent"   # linux binary: runs inside the workload container
SWA_SERVER_TAR="$SWA_BUNDLE_DIR/container-images/swa-server-${SWA_VERSION}-${SWA_IMG_ARCH}.tar"
SWA_SERVER_IMAGE="docker.io/library/swa-server:${SWA_VERSION}-${SWA_IMG_ARCH}"           # name inside the tar; not on Docker Hub
SWA_CLIENT_BIN="$PWD/swa-go-test/swa-go-test"                                           # built from ./swa-go-test; sha256 pinned in policy
WL_CLIENT="/usr/local/bin/swa-go-test"                                                  # same client inside the workload image
WL_IMAGE="localhost/swa-lab-workload:1.0"

# env_load <prod|dev>: per-environment names
env_load() {
  ENV=$1
  local rel
  case "$ENV" in
    prod) API_PORT=${PROD_API_PORT:-18443}; NODE_PORT=30843; rel=$PROD_SECRETS;;
    dev)  API_PORT=${DEV_API_PORT:-18543};  NODE_PORT=30943; rel=$DEV_SECRETS;;
    *) echo "env must be prod|dev" >&2; return 1;;
  esac
  SECRETS=""; for s in $rel; do SECRETS+="$SAFE_POLICY/$s "; done; SECRETS=${SECRETS% }
  TD="$ENV${LAB_ID:+.$LAB_ID}.swa.$BASE_DOMAIN"   # trust domain (unique per tenant)
  SG="sg-k3s-$ENV"                             # server group
  SERVER="swa-server-$ENV"                     # server component on the tenant
  NS="swa-$ENV"                                # k3s namespace; helm release + deployment + service account "swa-server"
  JWT_SUB="system:serviceaccount:$NS:swa-server"; JWT_AUD="conjur"   # projected SA token presented to the tenant
  NG="ng-$ENV"                                 # node group (= CN of the agent x509pop cert)
  AUTHN="swa-$ENV${LAB_ID:+-$LAB_ID}"          # authn-jwt/<AUTHN> for workloads (unique per tenant)
  WL="wl-$ENV"                                 # workload container (simulates one machine, outside k3s)
  SID="spiffe://$TD/$NG/workload/$SA_USER"     # expected workload SPIFFE ID
  HOST="data/swa/trust-domains/$TD/workloads/$SID"
  ST="state/$ENV"                              # per-environment pki, registered JWKS, authn_id, agent cert
}
