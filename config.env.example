# config.env - settings for the SWA docker lab (prod/dev). Copy to config.env and edit the "EDIT" section.
#   cp config.env.example config.env
# config.env is git-ignored (tenant names, users); every script sources it after cd to this directory.

# ===== EDIT: tenant ==========================================================================
SWA_API_BASE="https://<subdomain>.secretsmgr.cyberark.cloud"   # Secrets Manager SaaS tenant
IDENTITY_URL="https://<tenant-id>.id.cyberark.cloud"           # Identity tenant (01-get-token.sh)
SM_USER=""                                                     # Identity admin user; empty = prompt

# ===== EDIT: lab naming and secrets ==========================================================
BASE_DOMAIN="<domain>"             # trust domains: <env>.swa.<BASE_DOMAIN>
SA_USER="swa-demo-sa"              # service account (Linux user) running the workload in the container
SAFE_POLICY="data/vault/<safe>"    # policy branch holding the secrets the workloads may read
PROD_SECRETS="<account>/username <account>/password"           # relative to SAFE_POLICY
DEV_SECRETS="<account>/username <account>/password"

# ===== EDIT: SWA release bundle (swa-release-v<ver>.tgz extracted here) =====================
SWA_BUNDLE_DIR="/opt/download/swa"
SWA_VERSION="1.1.4"

# ===== Optional ===============================================================================
HOST_GW=""                         # host address seen from containers; empty = auto (docker bridge / podman gateway)

# ===== Derived - normally no need to change ==================================================
ENVS="prod dev"
SA_UID=1001
ADMIN_TOKEN_FILE="$PWD/.token"                                                          # written by 01-get-token.sh
SWA_AGENT_BIN="$SWA_BUNDLE_DIR/binaries/swa-agent_${SWA_VERSION}_linux_amd64/swa-agent"
SWA_SERVER_TAR="$SWA_BUNDLE_DIR/container-images/swa-server-${SWA_VERSION}-amd64.tar"
SWA_SERVER_IMAGE="docker.io/library/swa-server:${SWA_VERSION}-amd64"                   # name inside the tar; not on Docker Hub
SWA_CLIENT_BIN="$PWD/swa-go-test/swa-go-test"                                           # built from ./swa-go-test; sha256 pinned in policy
WL_CLIENT="/usr/local/bin/swa-go-test"                                                  # same client inside the workload image
WL_IMAGE="localhost/swa-lab-workload:1.0"

# env_load <prod|dev>: per-environment names
env_load() {
  ENV=$1
  local rel
  case "$ENV" in
    prod) API_PORT=18443; WEB_PORT=18080; rel=$PROD_SECRETS;;
    dev)  API_PORT=18543; WEB_PORT=18180; rel=$DEV_SECRETS;;
    *) echo "env must be prod|dev" >&2; return 1;;
  esac
  SECRETS=""; for s in $rel; do SECRETS+="$SAFE_POLICY/$s "; done; SECRETS=${SECRETS% }
  TD="$ENV.swa.$BASE_DOMAIN"                   # trust domain
  SG="sg-docker-$ENV"                          # server group
  SERVER="swa-server-$ENV"                     # server component + container
  NG="ng-$ENV"                                 # node group (= CN of the agent x509pop cert)
  AUTHN="swa-$ENV"                             # authn-jwt/<AUTHN> for workloads
  JWT_ISS="https://swa-server-$ENV.$BASE_DOMAIN"; JWT_SUB="swa-server-$ENV"; JWT_AUD="conjur"; JWT_TTL=3600
  WL="wl-$ENV"                                 # workload container (simulates one machine)
  SID="spiffe://$TD/$NG/workload/$SA_USER"     # expected workload SPIFFE ID
  HOST="data/swa/trust-domains/$TD/workloads/$SID"
  ST="state/$ENV"                              # per-environment pki, signer, tokens, config
}
